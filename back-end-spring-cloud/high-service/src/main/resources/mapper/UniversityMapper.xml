<?xml version="1.0" encoding="UTF-8"?>
<!--
  文件说明：拾光记微服务后端高中服务业务服务配置或映射文件，用于描述项目依赖、构建或 SQL 映射关系。
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.highservice.mapper.volunteer.UniversityMapper">

    <select id="searchUniversities" resultType="org.example.highservice.entity.volunteer.University">
        SELECT * FROM gaokao_university
        <where>
            <if test="keyword != null and keyword != ''">
                AND (university_name LIKE CONCAT('%', #{keyword}, '%')
                OR university_code LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="province != null and province != ''">
                AND province = #{province}
            </if>
            <if test="level != null and level != ''">
                AND level_tags = #{level}
            </if>
        </where>
        ORDER BY
        CASE level_tags
        WHEN '985' THEN 1
        WHEN '211' THEN 2
        WHEN '双一流' THEN 3
        WHEN '一本' THEN 4
        WHEN '二本' THEN 5
        ELSE 6
        END,
        university_name
    </select>

</mapper>